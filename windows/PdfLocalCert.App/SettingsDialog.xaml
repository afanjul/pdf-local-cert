<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PdfLocalCert.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    x:Uid="SettingsDialog"
    DefaultButton="Close">

    <ScrollViewer>
        <StackPanel Spacing="16" MinWidth="380">

            <muxc:InfoBar x:Name="PaywallBar" IsOpen="False" Severity="Warning" IsClosable="False" />

            <!-- Appearance: theme + language -->
            <StackPanel Spacing="8">
                <TextBlock x:Uid="AppearanceSection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="ThemeBox" x:Uid="Theme" HorizontalAlignment="Stretch"
                          SelectionChanged="OnThemeChanged">
                    <ComboBoxItem x:Uid="ThemeSystem" />
                    <ComboBoxItem x:Uid="ThemeLight" />
                    <ComboBoxItem x:Uid="ThemeDark" />
                </ComboBox>
                <ComboBox x:Name="LanguageBox" x:Uid="Language" HorizontalAlignment="Stretch"
                          SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem x:Uid="LanguageSystem" />
                    <ComboBoxItem x:Uid="LanguageSpanish" />
                    <ComboBoxItem x:Uid="LanguageEnglish" />
                </ComboBox>
                <TextBlock x:Uid="LanguageRestart"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- License / tier -->
            <StackPanel Spacing="8">
                <TextBlock x:Uid="License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="TierText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <StackPanel x:Name="ActivatePanel" Spacing="8">
                    <TextBox x:Name="LicenseBox" x:Uid="LicenseKey" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ActivateButton" x:Uid="Activate" Click="OnActivate" />
                        <TextBlock x:Name="ActivateError" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="DeactivateButton" x:Uid="Deactivate" Click="OnDeactivate"
                        Visibility="Collapsed" />
            </StackPanel>

            <!-- Output filename suffix -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Suffix" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox x:Name="SuffixBox" x:Uid="SuffixBox" />
                <TextBlock x:Uid="SuffixHelp"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <CheckBox x:Name="OpenAfterSignCheck" x:Uid="OpenAfterSign"
                          Margin="0,4,0,0" />
                <TextBlock x:Uid="OpenAfterSignHelp"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- About -->
            <StackPanel Spacing="2">
                <TextBlock x:Uid="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="AboutApp" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="AboutText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
