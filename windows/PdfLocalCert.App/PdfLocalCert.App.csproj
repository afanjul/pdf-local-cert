<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI 3 (Windows App SDK) desktop shell. Unpackaged for now (WindowsPackageType
    = None) so it builds/runs without MSIX; the MSIX packaging project is Phase 5.1.
    Targets the Win10 17763 floor from the design via TargetPlatformMinVersion while
    compiling against a newer SDK.

    Deployment model (validated on the Win11 VM — see windows/README.md):
      * .NET runtime  -> SELF-CONTAINED (publish -r win-x64, self-contained true):
        the user never installs .NET.
      * Windows App SDK -> FRAMEWORK-DEPENDENT (WindowsAppSDKSelfContained=false):
        WinAppSDK self-contained crashes WinUI unpackaged apps at startup
        (0xc000027b in combase). Instead the machine needs the WinAppSDK 1.7
        runtime + its x64 DDLM, provisioned once via the official redist
        (windowsappruntimeinstall-x64.exe). The MSIX in Phase 5 removes this step.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PdfLocalCert.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfLocalCert.Core\PdfLocalCert.Core.csproj" />
  </ItemGroup>

</Project>
