<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PdfLocalCert.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PDF Local Cert">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Command bar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton x:Name="OpenButton" x:Uid="OpenButton" Icon="OpenFile" Label="Open PDF" Click="OnOpenClicked" />
            <AppBarButton x:Name="NewButton" Icon="Add" Label="New" Click="OnNewClicked" IsEnabled="False" />
            <AppBarButton x:Name="SignButton" x:Uid="SignButton" Icon="Edit" Label="Sign" Click="OnSignClicked" IsEnabled="False" />
            <AppBarButton x:Name="VerifyButton" x:Uid="VerifyButton" Icon="Permissions" Label="Verify" Click="OnVerifyClicked" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="PingButton" x:Uid="PingButton" Icon="Sync" Label="Ping core" Click="OnPingClicked" />
            <AppBarButton x:Name="SettingsButton" x:Uid="SettingsButton" Icon="Setting" Label="Settings" Click="OnSettingsClicked" />
        </CommandBar>

        <!-- Section navigation: Sign / Batch / Verify (mirrors macOS segmented nav) -->
        <SelectorBar Grid.Row="1" x:Name="SectionBar" HorizontalAlignment="Center"
                     Margin="0,0,0,8" SelectionChanged="OnSectionChanged">
            <SelectorBarItem x:Name="SignSectionItem" Text="Sign" IsSelected="True" />
            <SelectorBarItem x:Name="BatchSectionItem" Text="Batch" />
            <SelectorBarItem x:Name="VerifySectionItem" Text="Verify" />
        </SelectorBar>

        <!-- Section host -->
        <Grid Grid.Row="2">

            <!-- ===================== SIGN ===================== -->
            <Grid x:Name="SignSection" Visibility="{x:Bind ViewModel.SignVisibility, Mode=OneWay}"
                  ColumnDefinitions="*,320">

                <!-- Left: page viewer OR empty-state drop zone -->
                <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                      AllowDrop="True" DragOver="OnViewerDragOver" Drop="OnViewerDrop">

                    <!-- Page viewer: continuous vertical scroll of rendered pages -->
                    <ScrollViewer x:Name="PageScroller" HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                  MinZoomFactor="1" MaxZoomFactor="4"
                                  SizeChanged="OnViewerSizeChanged" Padding="16"
                                  Visibility="{x:Bind ViewModel.PageViewerVisibility, Mode=OneWay}">
                        <ItemsControl x:Name="PagesItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,16" HorizontalAlignment="Center"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <!-- Image + a draw surface on top for placing the signature box -->
                                        <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <Image Source="{Binding Image}" Stretch="Fill" />
                                            <Canvas x:Name="DrawSurface" Background="Transparent"
                                                    PointerPressed="OnPagePointerPressed"
                                                    PointerMoved="OnPagePointerMoved"
                                                    PointerReleased="OnPagePointerReleased"
                                                    Tag="{Binding}">
                                                <!-- The drawn signature box -->
                                                <Border Canvas.Left="{Binding BoxX}" Canvas.Top="{Binding BoxY}"
                                                        Width="{Binding BoxW}" Height="{Binding BoxH}"
                                                        Visibility="{Binding BoxVisibility}"
                                                        BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Background="#330078D4" IsHitTestVisible="False">
                                                    <TextBlock Text="Signature" FontSize="11" Margin="4,2,0,0"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Zoom controls (1–4×) -->
                    <StackPanel Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                Padding="2" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{x:Bind ViewModel.PageViewerVisibility, Mode=OneWay}">
                        <Button Click="OnZoomOut" ToolTipService.ToolTip="Zoom out"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE71F;" FontSize="14" />
                        </Button>
                        <Button Click="OnZoomReset" ToolTipService.ToolTip="Reset zoom"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                        </Button>
                        <Button Click="OnZoomIn" ToolTipService.ToolTip="Zoom in"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <!-- Empty-state drop zone -->
                    <Border Margin="24" CornerRadius="14" Padding="40"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                            Visibility="{x:Bind ViewModel.DropZoneVisibility, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <FontIcon Glyph="&#xE7C3;" FontSize="48"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Drag a PDF here" Style="{StaticResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <Button Content="Open PDF" Click="OnOpenClicked"
                                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right sidebar: certificate + signature options -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer Grid.Row="0" Padding="20">
                            <StackPanel Spacing="18">

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Certificate" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <ComboBox x:Name="CertCombo"
                                              AutomationProperties.AutomationId="CertCombo"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Select a certificate"
                                              DisplayMemberPath="CommonName"
                                              ItemsSource="{x:Bind ViewModel.Identities, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedCert, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.CertDetailText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="2">
                                    <ToggleSwitch x:Name="VisibleSigToggle"
                                                  x:Uid="VisibleSigToggle"
                                                  AutomationProperties.AutomationId="VisibleSigToggle"
                                                  Header="Visible signature"
                                                  IsOn="{x:Bind ViewModel.VisibleSignature, Mode=TwoWay}"
                                                  Toggled="OnVisibleToggled" />
                                    <TextBlock Text="Draw a box on the page to place the signature."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <ToggleSwitch Header="Sign all pages" Margin="0,6,0,0"
                                                  AutomationProperties.AutomationId="SignAllToggle"
                                                  IsOn="{x:Bind ViewModel.SignAllPages, Mode=TwoWay}"
                                                  Visibility="{x:Bind ViewModel.SignAllVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <!-- Appearance editor (visible signature only) -->
                                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.AppearanceVisibility, Mode=OneWay}">
                                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />

                                    <!-- Live preview (approximate; bitmap-exact preview arrives in 7.7) -->
                                    <Border CornerRadius="6" MinHeight="56" Padding="8"
                                            Background="{x:Bind ViewModel.PreviewBackgroundBrush, Mode=OneWay}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewLines, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" FontSize="12" Foreground="Black" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Content -->
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Header="Content">
                                        <StackPanel Spacing="6">
                                            <CheckBox Content="Name" IsChecked="{x:Bind ViewModel.ShowName, Mode=TwoWay}" />
                                            <CheckBox Content="Label" Margin="20,0,0,0"
                                                      Visibility="{x:Bind ViewModel.LabelToggleVisibility, Mode=OneWay}"
                                                      IsChecked="{x:Bind ViewModel.ShowLabel, Mode=TwoWay}" />
                                            <TextBox Margin="20,0,0,0" PlaceholderText="Firmado por:"
                                                     Visibility="{x:Bind ViewModel.CustomLabelVisibility, Mode=OneWay}"
                                                     Text="{x:Bind ViewModel.CustomLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Date" IsChecked="{x:Bind ViewModel.ShowDate, Mode=TwoWay}" />
                                            <CheckBox Content="Reason" IsChecked="{x:Bind ViewModel.ShowReason, Mode=TwoWay}" />
                                            <TextBox Margin="20,0,0,0" PlaceholderText="e.g. I approve this document"
                                                     Visibility="{x:Bind ViewModel.ReasonFieldVisibility, Mode=OneWay}"
                                                     Text="{x:Bind ViewModel.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Location" IsChecked="{x:Bind ViewModel.ShowLocation, Mode=TwoWay}" />
                                            <TextBox Margin="20,0,0,0" PlaceholderText="e.g. Madrid, ES"
                                                     Visibility="{x:Bind ViewModel.LocationFieldVisibility, Mode=OneWay}"
                                                     Text="{x:Bind ViewModel.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- Style -->
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Header="Style">
                                        <StackPanel Spacing="6">
                                            <CheckBox Content="Border" IsChecked="{x:Bind ViewModel.ShowBorder, Mode=TwoWay}" />
                                            <CheckBox Content="Transparent background" IsChecked="{x:Bind ViewModel.TransparentBackground, Mode=TwoWay}" />
                                            <CheckBox Content="Wrap text" IsChecked="{x:Bind ViewModel.WrapText, Mode=TwoWay}" />
                                            <TextBlock Text="Text size" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <Slider Minimum="6" Maximum="16" StepFrequency="1"
                                                    Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- Presets -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Presets" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Saved appearances"
                                                  ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Save…" Click="OnSavePreset" />
                                            <Button Content="Delete" Click="OnDeletePreset" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <ToggleSwitch x:Name="TimestampToggle"
                                                  AutomationProperties.AutomationId="TimestampToggle"
                                                  Header="Timestamp (B-T)"
                                                  IsOn="{x:Bind ViewModel.UseTimestamp, Mode=TwoWay}" />
                                    <TextBlock Text="Add a trusted RFC 3161 timestamp (PAdES B-T)."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBox Header="TSA URL (RFC 3161)" Margin="0,4,0,0"
                                             Text="{x:Bind ViewModel.TsaUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{x:Bind ViewModel.TsaVisibility, Mode=OneWay}" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom: primary action -->
                        <StackPanel Grid.Row="1" Padding="20" Spacing="8">
                            <Button x:Name="SignAndSaveButton"
                                    AutomationProperties.AutomationId="SignAndSaveButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanSign, Mode=OneWay}"
                                    Click="OnSignClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16"
                                                  IsActive="{x:Bind ViewModel.IsSigning, Mode=OneWay}" />
                                    <TextBlock Text="Sign and save" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== BATCH (placeholder, phase 7.3) ===================== -->
            <Grid x:Name="BatchSection" Visibility="{x:Bind ViewModel.BatchVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="32"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Batch signing" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Coming in a later parity phase."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ===================== VERIFY (placeholder, phase 7.4) ===================== -->
            <Grid x:Name="VerifySection" Visibility="{x:Bind ViewModel.VerifyVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8FB;" FontSize="32"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Verify signatures" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Use the Verify button in the toolbar for now. A multi-file queue is coming in a later parity phase."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" x:Name="VersionText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
