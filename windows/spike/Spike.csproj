<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway Phase-3 crypto spike. De-risks the Windows signing path before the
    WinUI shell exists: enumerate certs (X509Store), sign the core's TBS via CNG,
    drive a real prepare -> sign -> finalize -> verify round-trip against the
    cross-compiled pdflocalcert-core.exe. Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>plc-spike</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
