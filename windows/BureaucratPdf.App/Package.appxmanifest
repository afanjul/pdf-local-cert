<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest (Phase 5.1). Declares the Windows App SDK 1.7 runtime as a
  PackageDependency so end users never run the windowsappruntimeinstall redist by
  hand (this is what task 5.3 verifies). Identity Publisher must match the signing
  cert's subject; the placeholder below is replaced for dev self-sign (5.2) and the
  production OV/EV cert (5.5).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Warelabs.BureaucratPdf"
    Publisher="CN=Bureaucrat PDF (Dev)"
    Version="1.0.16.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Bureaucrat PDF</DisplayName>
    <PublisherDisplayName>Warelabs</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <!-- WinAppSDK 1.7 runtime: provisioned automatically when the MSIX installs,
         so no separate windowsappruntimeinstall step is needed by end users. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.7"
                       MinVersion="7000.522.1444.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="BureaucratPdf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Bureaucrat PDF"
        Description="Sign and verify PDFs locally. Your private key never leaves the Windows certificate store."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" Square71x71Logo="Images\SmallTile.png" Square310x310Logo="Images\LargeTile.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" BackgroundColor="#2860BF" />
      </uap:VisualElements>
      <Extensions>
        <!-- Open .pdf via "Open with" / file association. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
