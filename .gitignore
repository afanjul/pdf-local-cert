# macOS
.DS_Store
._*

# Swift Package Manager
.build/
.swiftpm/

# Rust build output
core/target/
target/

# C# / .NET build output (windows/ shell + spike)
**/bin/
**/obj/

# Local app/package builds, per platform: apple/build (the .app + dmg),
# windows/build (the .msix). Bare pattern matches the dir at any depth.
build/
DerivedData/
.local-build/
samples

# Large 4K demo masters — only the 1080p versions are published in the README
Resources/*-4K.mp4
apple/Resources/*-4K.mp4

# Secrets / signing material
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.mobileprovision
*.provisionprofile
.env
.env.*

